 "lines": [
  {
   "id": "s02_l01",
   "tts": "저는 성균관대학교 이사 학번이고,",
   "pause": "S",
   "start": 0.04,
   "end": 2.642,
   "rate": 5.38
  },
  {
   "id": "s02_l02",
   "tts": "일 학년을 마친 뒤, 두 개 학기를 수료하고 군 입대를 했습니다.",
   "pause": "M",
   "start": 2.994,
   "end": 6.684,
   "rate": 7.04
  },
  {
   "id": "s02_l03",
   "tts": "그리고 이천이십육 년 시월, 전역을 앞두고 있습니다.",
   "pause": "M",
   "start": 7.319,
   "end": 10.969,
   "rate": 6.95
  },
  {
   "id": "s02_l04",
   "tts": "군 입대 전부터, 전역하고 바로 학교로 돌아가기보다는,",
   "pause": "S",
   "start": 11.629,
   "end": 16.204,
   "rate": 5.49
  },
  {
   "id": "s02_l05",
   "tts": "한 번쯤 해외에서 살아보고 싶다는 생각이 있었습니다.",
   "pause": "M",
   "start": 16.556,
   "end": 19.281,
   "rate": 8.07
  },
  {
   "id": "s02_l06",
   "tts": "특히 군 생활을 하면서, 그 마음은 더 커졌습니다.",
   "pause": "M",
   "start": 19.993,
   "end": 24.203,
   "rate": 5.94
  },
  {
   "id": "s02_l07",
   "tts": "조금 더 넓은 세상으로 나가서,",
   "pause": "S",
   "start": 24.728,
   "end": 27.038,
   "rate": 5.44
  },
  {
   "id": "s02_l08",
   "tts": "새로운 환경에서 살아보고 싶었습니다.",
   "pause": "M",
   "start": 27.268,
   "end": 29.158,
   "rate": 8.47
  },
  {
   "id": "s02_l09",
   "tts": "지원 당시 제 성적은,",
   "pause": "S",
   "start": 29.87,
   "end": 31.935,
   "rate": 4.57
  },
  {
   "id": "s02_l10",
   "tts": "학점 사 점 삼삼.",
   "pause": "M",
   "start": 32.287,
   "end": 33.792,
   "rate": 4.33
  },
  {
   "id": "s02_l11",
   "tts": "아이엘츠 팔 점 영.",
   "pause": "M",
   "start": 34.417,
   "end": 35.867,
   "rate": 5.26
  },
  {
   "id": "s02_l12",
   "tts": "이제 남은 건 하나였습니다.",
   "pause": "M",
   "start": 36.579,
   "end": 38.449,
   "rate": 6.98
  },
  {
