   "start": 7.471,
   "end": 9.391,
   "rate": 8.33
  },
  {
   "id": "s03_l04",
   "tts": "저는 조금 달랐습니다.",
   "pause": "M",
   "start": 9.961,
   "end": 11.871,
   "rate": 4.71
  },
  {
   "id": "s03_l05",
   "tts": "저에게 더 중요했던 건,",
