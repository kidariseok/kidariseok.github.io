   "start": 12.506,
   "end": 14.406,
   "rate": 5.22
  },
  {
   "id": "s03_l06",
   "tts": "유럽에서 실제로 살아보는 것.",
   "pause": "M",
   "start": 14.646,
   "end": 16.456,
   "rate": 6.63
  },
  {
   "id": "s03_l07",
   "tts": "그리고 가능하면, 여러 나라를 여행해보는 것.",
