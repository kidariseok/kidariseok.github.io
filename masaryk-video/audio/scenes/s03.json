 "lines": [
  {
   "id": "s03_l01",
   "tts": "교환학생의 목적은, 사람마다 다를 겁니다.",
   "pause": "M",
   "start": 0.04,
   "end": 3.112,
   "rate": 6.45
  },
  {
   "id": "s03_l02",
   "tts": "어떤 사람은 좋은 학교에서 공부하고 싶을 수도 있고,",
   "pause": "S",
   "start": 3.824,
   "end": 7.119,
   "rate": 6.82
  },
  {
   "id": "s03_l03",
   "tts": "영어 실력을 늘리고 싶을 수도 있습니다.",
