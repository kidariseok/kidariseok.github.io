 "lines": [
  {
   "id": "s05_l01",
   "tts": "그런데 기준을 만들었다고 해서, 학교가 바로 정해진 건 아니었습니다.",
   "pause": "M",
   "start": 0.04,
   "end": 4.802,
   "rate": 6.3
  },
  {
   "id": "s05_l02",
   "tts": "오히려 여기서부터 시작이었습니다.",
   "pause": "M",
   "start": 5.437,
   "end": 7.742,
   "rate": 7.19
  },
  {
   "id": "s05_l03",
   "tts": "처음에는,",
   "pause": "S",
   "start": 8.454,
   "end": 9.274,
   "rate": 4.88
  },
  {
   "id": "s05_l04",
   "tts": "체코 마사릭 유니버시티가 괜찮겠는데? 라고 생각했습니다.",
   "pause": "M",
   "start": 9.626,
   "end": 13.336,
   "rate": 6.67
  },
  {
   "id": "s05_l05",
   "tts": "그런데 다시 찾아보니,",
   "pause": "S",
   "start": 13.901,
   "end": 15.831,
   "rate": 5.07
  },
  {
   "id": "s05_l06",
   "tts": "스페인 아이이 유니버시티도 괜찮은데?",
   "pause": "M",
   "start": 16.111,
   "end": 19.231,
   "rate": 5.55
  },
  {
   "id": "s05_l07",
   "tts": "마드리드에 있고, 학교 수준도 좋아 보였습니다.",
   "pause": "M",
   "start": 19.943,
   "end": 22.973,
   "rate": 6.88
  },
  {
   "id": "s05_l08",
   "tts": "그런데 경영대학 중심이라는 점이 조금 걸렸습니다.",
   "pause": "M",
   "start": 23.685,
   "end": 27.54,
   "rate": 5.74
  },
  {
   "id": "s05_l09",
   "tts": "그래서 이번에는, 네덜란드로 눈을 돌렸습니다.",
   "pause": "M",
   "start": 28.252,
   "end": 31.062,
   "rate": 7.24
  },
  {
   "id": "s05_l10",
   "tts": "브레이어 유니버시테이트 암스테르담이 최고 아닌가?",
   "pause": "M",
   "start": 31.657,
   "end": 35.627,
   "rate": 6.3
  },
  {
   "id": "s05_l11",
   "tts": "그런데 알고 보니,",
   "pause": "M",
   "start": 36.339,
   "end": 37.689,
   "rate": 5.65
  },
  {
   "id": "s05_l12",
   "tts": "원래 열 명을 뽑던 자리를, 이번에는 한 명으로 줄였더라고요.",
   "pause": "L",
   "start": 38.109,
   "end": 42.079,
   "rate": 6.23
  },
  {
   "id": "s05_l13",
   "tts": "탈락.",
   "pause": "L",
   "start": 42.929,
   "end": 43.294,
   "rate": 5.48
  },
  {
   "id": "s05_l14",
   "tts": "그래도 네덜란드가 아쉬워서, 다른 학교들도 찾아봤습니다.",
   "pause": "M",
   "start": 44.194,
   "end": 48.044,
   "rate": 6.23
  },
  {
   "id": "s05_l15",
   "tts": "그리고 다시 독일.",
   "pause": "M",
   "start": 48.734,
   "end": 50.134,
   "rate": 5.49
  },
  {
   "id": "s05_l16",
   "tts": "엘엠유,",
   "pause": "C",
   "start": 50.734,
   "end": 51.589,
   "rate": 3.51
  },
  {
   "id": "s05_l17",
   "tts": "프랑크푸르트 유니버시티 오브 어플라이드 사이언스,",
   "pause": "C",
   "start": 51.921,
   "end": 54.646,
   "rate": 8.07
  },
  {
   "id": "s05_l18",
   "tts": "프리 유니버시티 오브 베를린.",
   "pause": "M",
   "start": 54.978,
   "end": 56.418,
   "rate": 8.33
  },
  {
   "id": "s05_l19",
   "tts": "그런데 또 문제가 있었습니다.",
   "pause": "M",
   "start": 57.113,
   "end": 59.078,
   "rate": 6.9
  },
  {
   "id": "s05_l20",
   "tts": "학사 일정.",
   "pause": "M",
   "start": 59.773,
   "end": 60.663,
   "rate": 4.49
  },
  {
   "id": "s05_l21",
   "tts": "사월에 시작해서 구월에 끝나는 학교들이 많았고,",
   "pause": "S",
   "start": 61.375,
   "end": 64.625,
   "rate": 6.37
  },
  {
   "id": "s05_l22",
   "tts": "그러면 한국 이학기 복학 일정과 겹칠 수 있었습니다.",
   "pause": "L",
   "start": 64.805,
   "end": 68.125,
   "rate": 6.33
  },
  {
   "id": "s05_l23",
   "tts": "또 탈락.",
   "pause": "L",
   "start": 68.975,
   "end": 69.435,
   "rate": 6.52
  },
  {
   "id": "s05_l24",
   "tts": "이번에는,",
   "pause": "S",
   "start": 70.285,
   "end": 71.635,
   "rate": 3.96
  },
  {
   "id": "s05_l25",
   "tts": "성적도 괜찮은데, 영국 셰필드를 갈까? 생각했습니다.",
   "pause": "M",
   "start": 71.84,
   "end": 75.56,
   "rate": 6.03
  },
  {
   "id": "s05_l26",
   "tts": "그런데 또 고민이 됐습니다.",
   "pause": "M",
   "start": 76.272,
   "end": 77.757,
   "rate": 8.12
  },
  {
   "id": "s05_l27",
   "tts": "비싸다.",
   "pause": "M",
   "start": 78.469,
   "end": 78.984,
   "rate": 5.83
  },
  {
   "id": "s05_l28",
   "tts": "그리고 여행을 많이 하고 싶은 저에게, 영국의 위치도 썩 마음에 들지 않았습니다.",
   "pause": "S",
   "start": 79.696,
   "end": 84.993,
   "rate": 6.42
  }
 ],
