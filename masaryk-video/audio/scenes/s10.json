 "lines": [
  {
   "id": "s10_l01",
   "tts": "마지막으로, 교환학생을 준비하면서 제가 직접 느낀 팁 두 가지를 말씀드리겠습니다.",
   "pause": "L",
   "start": 0.04,
   "end": 5.917,
   "rate": 6.59
  },
  {
   "id": "s10_l02",
   "tts": "첫 번째.",
   "pause": "M",
   "start": 7.129,
   "end": 7.714,
   "rate": 5.13
  },
  {
   "id": "s10_l03",
   "tts": "정말 가고 싶은 학교라면, 직접 문의해보세요.",
   "pause": "M",
   "start": 8.426,
   "end": 11.686,
   "rate": 7.13
  },
  {
   "id": "s10_l04",
   "tts": "저도 프랑크푸르트 유니버시티 오브 어플라이드 사이언스에 관심이 있었는데,",
   "pause": "S",
   "start": 12.398,
   "end": 18.053,
   "rate": 6.45
  },
  {
   "id": "s10_l05",
   "tts": "당시에는 세 개 학기 이상 수료해야 한다고 적혀 있었습니다.",
   "pause": "M",
   "start": 18.405,
   "end": 22.41,
   "rate": 6.71
  },
  {
   "id": "s10_l06",
   "tts": "저는 두 개 학기만 수료한 상태였지만,",
   "pause": "S",
   "start": 22.965,
   "end": 25.245,
   "rate": 6.58
  },
  {
   "id": "s10_l07",
   "tts": "혹시나 하는 마음에 직접 이메일을 보냈습니다.",
   "pause": "M",
   "start": 25.597,
   "end": 28.222,
   "rate": 8.12
  },
  {
   "id": "s10_l08",
   "tts": "그리고 학교에서는, 제 상황이면 지원해도 괜찮다는 답변을 받았습니다.",
   "pause": "M",
   "start": 28.934,
   "end": 34.086,
   "rate": 6.78
  },
  {
   "id": "s10_l09",
   "tts": "결국 학사 일정 때문에 실제 지원까지 하지는 않았지만,",
   "pause": "S",
   "start": 34.798,
   "end": 38.423,
   "rate": 6.36
  },
  {
   "id": "s10_l10",
   "tts": "이 경험을 통해 한 가지를 배웠습니다.",
   "pause": "M",
   "start": 38.775,
   "end": 40.85,
   "rate": 7.69
  },
  {
   "id": "s10_l11",
   "tts": "홈페이지에 적힌 기준만 보고, 미리 포기할 필요는 없다는 것.",
   "pause": "M",
   "start": 41.562,
   "end": 45.387,
   "rate": 6.93
  },
  {
   "id": "s10_l12",
   "tts": "물론 모든 학교가 예외를 인정해주는 것은 아닙니다.",
   "pause": "M",
   "start": 46.057,
   "end": 49.884,
   "rate": 6.31
  },
  {
   "id": "s10_l13",
   "tts": "하지만 정말 가고 싶은 학교라면, 한 번쯤 직접 물어보는 것도 좋은 방법입니다.",
   "pause": "L",
   "start": 50.424,
   "end": 55.684,
   "rate": 7.24
  },
  {
   "id": "s10_l14",
   "tts": "두 번째.",
   "pause": "M",
   "start": 56.896,
   "end": 57.521,
   "rate": 4.8
  },
  {
   "id": "s10_l15",
   "tts": "아카데믹 캘린더는 반드시 확인하세요.",
   "pause": "M",
   "start": 58.233,
   "end": 61.308,
   "rate": 6.6
  },
  {
   "id": "s10_l16",
   "tts": "학교 이름이나 도시만 보고 선택하지 말고,",
   "pause": "S",
   "start": 61.858,
   "end": 64.363,
   "rate": 6.79
  },
  {
   "id": "s10_l17",
   "tts": "이 학교에서 한 학기를 마치고 돌아왔을 때,",
   "pause": "S",
   "start": 64.715,
   "end": 67.345,
   "rate": 6.46
  },
  {
   "id": "s10_l18",
   "tts": "한국에서 정상적으로 다음 학기를 시작할 수 있는가?",
   "pause": "M",
   "start": 67.59,
   "end": 71.015,
   "rate": 6.79
  },
  {
   "id": "s10_l19",
   "tts": "여기까지 확인해야 합니다.",
   "pause": "S",
   "start": 71.705,
   "end": 73.077,
   "rate": 8.02
  }
 ],
