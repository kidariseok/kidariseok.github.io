{
 "id": "s04",
 "dur": 115.709,
 "sr": 24000,
 "lines": [
  {
   "id": "s04_l01",
   "tts": "첫 번째는 위치였습니다.",
   "pause": "M",
   "start": 0.04,
   "end": 1.757,
   "rate": 5.82
  },
  {
   "id": "s04_l02",
   "tts": "유럽 여행을 많이 하고 싶었기 때문에,",
   "pause": "S",
   "start": 2.469,
   "end": 4.334,
   "rate": 8.04
  },
  {
   "id": "s04_l03",
   "tts": "단순히 유럽에 있는 것보다, 유럽의 중심에 가까운가를 중요하게 봤습니다.",
   "pause": "M",
   "start": 4.686,
   "end": 9.326,
   "rate": 7.33
  },
  {
   "id": "s04_l04",
   "tts": "체코나 독일처럼, 여러 나라와 가까운 지역에 점수를 줬고,",
   "pause": "S",
   "start": 10.038,
   "end": 13.983,
   "rate": 6.37
  },
  {
   "id": "s04_l05",
   "tts": "공항이나 주요 기차역까지 얼마나 걸리는지도 확인했습니다.",
   "pause": "P",
   "start": 14.335,
   "end": 18.015,
   "rate": 7.72
  },
  {
   "id": "s04_l06",
   "tts": "두 번째는, 학교의 수준과 명성.",
   "pause": "M",
   "start": 18.807,
   "end": 21.457,
   "rate": 5.35
  },
  {
   "id": "s04_l07",
   "tts": "교환학생으로 잠시 다니더라도, 학교 이름은 결국 이력서에 남습니다.",
   "pause": "M",
   "start": 22.169,
   "end": 26.819,
   "rate": 6.02
  },
  {
   "id": "s04_l08",
   "tts": "그래서 큐에스 랭킹 같은 자료를 참고하면서,",
   "pause": "S",
   "start": 27.254,
   "end": 30.124,
   "rate": 6.27
  },
  {
   "id": "s04_l09",
   "tts": "학교의 전반적인 수준과, 전공 관련 경쟁력도 비교했습니다.",
   "pause": "P",
   "start": 30.304,
   "end": 35.351,
   "rate": 5.61
  },
  {
   "id": "s04_l10",
   "tts": "세 번째는 물가.",
   "pause": "M",
   "start": 36.143,
   "end": 37.323,
   "rate": 5.77
  },
  {
   "id": "s04_l11",
   "tts": "교환학생을 가면, 여행 때문에 자연스럽게 돈을 많이 쓰게 됩니다.",
   "pause": "M",
   "start": 38.035,
   "end": 41.995,
   "rate": 6.87
  },
  {
   "id": "s04_l12",
   "tts": "그래서 적어도 평소 생활하는 곳에서는,",
   "pause": "S",
   "start": 42.707,
   "end": 45.427,
   "rate": 5.88
  },
  {
   "id": "s04_l13",
   "tts": "조금 더 여유 있게 지낼 수 있는 국가를 선호했습니다.",
   "pause": "P",
   "start": 45.692,
   "end": 49.889,
   "rate": 6.64
  },
  {
   "id": "s04_l14",
   "tts": "그리고 정말 중요하게 본 네 번째 기준.",
   "pause": "M",
   "start": 50.681,
   "end": 53.151,
   "rate": 6.59
  },
  {
   "id": "s04_l15",
   "tts": "바로 아카데믹 캘린더, 학사 일정입니다.",
   "pause": "M",
   "start": 53.863,
   "end": 56.813,
   "rate": 6.72
  },
  {
   "id": "s04_l16",
   "tts": "유럽 대학은 학교마다, 학기가 시작하고 끝나는 시점이 정말 다릅니다.",
   "pause": "M",
   "start": 57.525,
   "end": 62.32,
   "rate": 6.38
  },
  {
   "id": "s04_l17",
   "tts": "어떤 학교는 일월에 시작하고,",
   "pause": "S",
   "start": 63.032,
   "end": 65.022,
   "rate": 6.45
  },
  {
   "id": "s04_l18",
   "tts": "어떤 학교는 사월에 시작해서 구월에 끝나기도 합니다.",
   "pause": "M",
   "start": 65.202,
   "end": 68.212,
   "rate": 7.31
  },
  {
   "id": "s04_l19",
   "tts": "저는 이천이십육 년 시월 전역 예정이었기 때문에,",
   "pause": "S",
   "start": 68.924,
   "end": 72.169,
   "rate": 6.41
  },
  {
   "id": "s04_l20",
   "tts": "전역 후 불필요하게 긴 공백을 만들고 싶지 않았습니다.",
   "pause": "M",
   "start": 72.521,
   "end": 75.546,
   "rate": 7.27
  },
  {
   "id": "s04_l21",
   "tts": "그래서 일월이나 이월에 시작하고,",
   "pause": "S",
   "start": 76.258,
   "end": 78.623,
   "rate": 6.29
  },
  {
   "id": "s04_l22",
   "tts": "한국 복학 일정과 충돌하지 않는 학교를 우선적으로 찾았습니다.",
   "pause": "P",
   "start": 78.975,
   "end": 83.882,
   "rate": 6.29
  },
  {
   "id": "s04_l23",
   "tts": "다섯 번째는, 합격 가능성.",
   "pause": "M",
   "start": 84.674,
   "end": 86.439,
   "rate": 6.35
  },
  {
   "id": "s04_l24",
   "tts": "에브리타임에서 이전 합격자들에게 직접 물어보고,",
   "pause": "S",
   "start": 87.151,
   "end": 90.696,
   "rate": 6.86
  },
  {
   "id": "s04_l25",
   "tts": "학교 수학보고서도 확인하면서,",
   "pause": "S",
   "start": 91.048,
   "end": 93.043,
   "rate": 7.28
  },
  {
   "id": "s04_l26",
   "tts": "제 성적으로 어느 정도 가능성이 있는지 추정했습니다.",
   "pause": "P",
   "start": 93.395,
   "end": 96.415,
   "rate": 7.68
  },
  {
   "id": "s04_l27",
   "tts": "마지막은 기숙사.",
   "pause": "M",
   "start": 97.207,
   "end": 98.297,
   "rate": 7.91
  },
  {
   "id": "s04_l28",
   "tts": "해외에서 처음 집을 구하고 계약하는 것보다는,",
   "pause": "S",
   "start": 98.762,
   "end": 103.367,
   "rate": 4.44
  },
  {
   "id": "s04_l29",
   "tts": "교환학생에게 기숙사를 제공하는 학교를 훨씬 선호했습니다.",
   "pause": "P",
   "start": 103.719,
   "end": 107.504,
   "rate": 6.79
  },
  {
   "id": "s04_l30",
   "tts": "결국 저에게 중요한 건,",
   "pause": "S",
   "start": 108.296,
   "end": 110.628,
   "rate": 3.86
  },
  {
   "id": "s04_l31",
   "tts": "가장 좋은 학교가 아니라,",
   "pause": "M",
   "start": 110.98,
   "end": 112.545,
   "rate": 6.39
  },
  {
   "id": "s04_l32",
   "tts": "나에게 가장 잘 맞는 학교였습니다.",
   "pause": "S",
   "start": 113.257,
   "end": 115.629,
   "rate": 5.9
  }
 ],
